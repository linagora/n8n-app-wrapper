{
  "name": "n8n",
  "name_prefix": "Twake",
  "slug": "n8n",
  "version": "1.0.0",
  "type": "webapp",
  "licence": "Apache-2.0",
  "icon": "assets/icon.png",
  "categories": ["productivity"],
  "source": "https://github.com/linagora/n8n-app-wrapper",
  "editor": "Linagora",
  "developer": {
    "name": "Linagora",
    "url": "https://twake.app"
  },
  "default_locale": "en",
  "locales": {
    "en": {
      "name": "n8n",
      "short_description": "Embedded n8n workflow automation",
      "long_description": "Cozy wrapper around an n8n instance. The embedded service URL is provided at runtime through the `n8n.embedded-app-url` flag."
    },
    "fr": {
      "name": "n8n",
      "short_description": "n8n embarqué (automatisation)",
      "long_description": "Wrapper Cozy autour d'une instance n8n. L'URL du service embarqué est fournie à l'exécution via le flag `n8n.embedded-app-url`."
    }
  },
  "routes": {
    "/": {
      "folder": "/",
      "index": "index.html",
      "public": false
    }
  },
  "permissions": {
    "apps": {
      "description": "Required by the cozy-bar to display the icons of the apps",
      "type": "io.cozy.apps",
      "verbs": ["GET"]
    },
    "settings": {
      "description": "Required by the cozy-bar and to read application flags",
      "type": "io.cozy.settings",
      "verbs": ["GET"]
    },
    "contacts": {
      "description": "Required by the cozy-bar to display the avatar",
      "type": "io.cozy.contacts",
      "verbs": ["GET"]
    },
    "files": {
      "description": "Required by the cozy-bar to get shortcuts",
      "type": "io.cozy.files",
      "verbs": ["GET"]
    }
  }
}
